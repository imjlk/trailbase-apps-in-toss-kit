{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "enabledManagers": [
    "cargo",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "mise",
    "npm"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track TrailBase upstream versions documented in docs/*/trailbase-tracking.md",
      "managerFilePatterns": ["/(^|/)docs/(en|ko)/trailbase-tracking\\.md$/"],
      "matchStrings": [
        "<!--\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*-->\\s*\\n-\\s*`[^`]+`:\\s*`(?<currentValue>[^`]+)`"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/",
      "/(^|/)templates/trailbase/compose/[^/]+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "TrailBase client/runtime crates, packages, and documented upstream versions",
      "matchPackageNames": [
        "trailbase",
        "trailbase-wasm",
        "trailbase-client",
        "trailbase-qs",
        "trailbase-schema",
        "trailbase-wasm-common",
        "trailbaseio/trailbase",
        "/^trailbase[-_].*/"
      ],
      "groupName": "TrailBase client/runtime stack",
      "labels": ["dependencies", "trailbase"],
      "prPriority": 25,
      "minimumReleaseAge": "2 days",
      "automerge": false
    },
    {
      "description": "TrailBase 0.x updates require manual review",
      "matchPackageNames": [
        "trailbase",
        "trailbase-wasm",
        "trailbase-client",
        "trailbase-qs",
        "trailbase-schema",
        "trailbase-wasm-common",
        "trailbaseio/trailbase",
        "/^trailbase[-_].*/"
      ],
      "matchCurrentVersion": "/^0\\./",
      "labels": ["dependencies", "trailbase", "manual-review"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "TrailBase upstream controls the Rust toolchain version tracked in mise",
      "matchManagers": ["mise"],
      "matchPackageNames": ["rust"],
      "enabled": false
    }
  ]
}
