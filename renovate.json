{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "enabledManagers": [
    "cargo",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "mise",
    "npm"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track documented upstream reference versions in docs/* tracking pages",
      "managerFilePatterns": [
        "/(^|/)docs/(en|ko)/trailbase-tracking\\.md$/",
        "/(^|/)docs/(en|ko)/apps-in-toss-tracking\\.md$/"
      ],
      "matchStrings": [
        "<!--\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*-->\\s*\\n-\\s*`[^`]+`:\\s*`(?<currentValue>[^`]+)`"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/",
      "/(^|/)templates/trailbase/compose/[^/]+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "TrailBase client/runtime crates, packages, and documented upstream versions",
      "matchPackageNames": [
        "trailbase",
        "trailbase-wasm",
        "trailbase-client",
        "trailbase-qs",
        "trailbase-schema",
        "trailbase-wasm-common",
        "trailbaseio/trailbase",
        "/^trailbase[-_].*/"
      ],
      "groupName": "TrailBase client/runtime stack",
      "labels": ["dependencies", "trailbase"],
      "prPriority": 25,
      "minimumReleaseAge": "2 days",
      "automerge": false
    },
    {
      "description": "TrailBase 0.x updates require manual review",
      "matchPackageNames": [
        "trailbase",
        "trailbase-wasm",
        "trailbase-client",
        "trailbase-qs",
        "trailbase-schema",
        "trailbase-wasm-common",
        "trailbaseio/trailbase",
        "/^trailbase[-_].*/"
      ],
      "matchCurrentVersion": "/^0\\./",
      "labels": ["dependencies", "trailbase", "manual-review"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "TrailBase upstream controls the Rust toolchain version tracked in mise",
      "matchManagers": ["mise"],
      "matchPackageNames": ["rust"],
      "enabled": false
    },
    {
      "description": "Apps in Toss, Granite, and TDS reference packages require manual review",
      "matchPackageNames": [
        "@apps-in-toss/framework",
        "@apps-in-toss/web-framework",
        "/^@apps-in-toss\\/.*/",
        "@toss/tds-react-native",
        "@toss/tds-mobile",
        "/^@toss\\/tds-.*/",
        "create-granite-app",
        "@granite-js/react-native",
        "/^@granite-js\\/.*/",
        "@toss-design-system/react-native",
        "@toss-design-system/mobile",
        "/^@toss-design-system\\/.*/"
      ],
      "groupName": "Apps in Toss SDK, Granite, and TDS stack",
      "labels": ["dependencies", "apps-in-toss"],
      "prPriority": 20,
      "minimumReleaseAge": "2 days",
      "automerge": false
    },
    {
      "description": "Apps in Toss 0.x updates require manual review",
      "matchPackageNames": [
        "@apps-in-toss/framework",
        "@apps-in-toss/web-framework",
        "/^@apps-in-toss\\/.*/",
        "@toss/tds-react-native",
        "@toss/tds-mobile",
        "/^@toss\\/tds-.*/",
        "create-granite-app",
        "@granite-js/react-native",
        "/^@granite-js\\/.*/"
      ],
      "matchCurrentVersion": "/^0\\./",
      "labels": ["dependencies", "apps-in-toss", "manual-review"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
