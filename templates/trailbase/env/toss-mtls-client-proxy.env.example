COMPOSE_PROFILES=toss-proxy
TOSS_MTLS_CLIENT_PROXY_IMAGE=ghcr.io/imjlk/trailbase-apps-in-toss-kit/toss-mtls-client-proxy:0.1.4
TOSS_LOGIN_MODE=proxy
MTLS_PROXY_URL=http://toss-mtls-client-proxy:8787
MTLS_PROXY_TOKEN=replace-with-internal-proxy-token

MTLS_PROXY_MODE=stub
# MTLS_PROXY_MODE=forward
# MTLS_UPSTREAM_BASE_URL=https://apps-in-toss-api.toss.im
# MTLS_PROXY_REQUEST_BODY_LIMIT_BYTES=1048576
# MTLS_PROXY_UPSTREAM_BODY_LIMIT_BYTES=2097152
# MTLS_PROXY_UPSTREAM_TIMEOUT_MS=15000
# MTLS_PROXY_IAP_ORDER_STATUS_MAX_ATTEMPTS=6
# MTLS_PROXY_IAP_ORDER_STATUS_RETRY_DELAY_MS=350
# MTLS_PROXY_DEBUG=false
# Optional fallback for env-only promotion consumers.
# Apps with DB-backed campaign state can send promotionCode and amount per proxy request instead.
# TOSS_PROMOTION_CODE=replace-with-toss-console-promotion-code
# TOSS_PROMOTION_AMOUNT=50

# Certificate files live inside the proxy container.
# Copy one Toss Console pair into the mtls_client_certs volume:
#   *_public.crt and *_private.key
# The proxy auto-detects that pair before using explicit fallback paths.
# MTLS_CERT_DIR=/run/mtls
# Optional fallback paths when the volume has no complete Toss Console pair:
# MTLS_CLIENT_CERT_PATH=/run/mtls/<your-cert>_public.crt
# MTLS_CLIENT_KEY_PATH=/run/mtls/<your-cert>_private.key
# MTLS_CA_CERT_PATH=/run/mtls/ca-cert.pem
