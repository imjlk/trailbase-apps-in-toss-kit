# Toss Login unlink callback settings for the TrailBase app service.
# Configure the same Basic Auth credential in the Apps in Toss Console callback settings.
TOSS_LOGIN_UNLINK_BASIC_AUTH=replace-with-unlink-callback-user:replace-with-unlink-callback-password

# Apps in Toss supports GET or POST callbacks. Prefer POST unless the console integration requires GET.
TOSS_UNLINK_CALLBACK_METHODS=POST

# The app uses this secret to derive toss_user_key_hmac from callback userKey values.
TOSS_USER_KEY_HMAC_SECRET=replace-with-64-plus-random-chars
