# For WASM, render these values into the separately mounted /settings.json.
# Host environment variables alone are not inherited by the sandbox.
# Set to 1 BEFORE booting any restored database. This environment must be outside
# the restored backup and set on every API/worker process. Status reads still work.
# Clear only after independent witness reconciliation and explicit operator resume.
KIT_OPERATIONS_HOLD=1

# Enable built-in policy hooks only after applying operation_policies.sql.
KIT_OPERATION_POLICIES_ENABLED=1
