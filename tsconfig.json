{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/ait-rn/src/**/*.ts",
    "packages/ait-rn/type-tests/**/*.ts",
    "packages/trailbase-client/src/**/*.ts",
    "packages/trailbase-client/type-tests/**/*.ts"
  ]
}
