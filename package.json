{
  "name": "trailbase-apps-in-toss-kit",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "packages:test": "bun install --frozen-lockfile && bun test packages/trailbase-runtime packages/trailbase-client packages/ait-rn packages/ait-web packages/release-tools",
    "runtime:test": "bun test packages/trailbase-runtime",
    "client:test": "bun test packages/trailbase-client",
    "renovate:validate": "npm exec --yes --package renovate -- renovate-config-validator --strict",
    "trailbase:snapshot": "node scripts/snapshot-trailbase-release.mjs",
    "trailbase:rust-policy:sync": "node scripts/sync-trailbase-rust-policy.mjs",
    "trailbase:rust-policy:check": "node scripts/sync-trailbase-rust-policy.mjs --check",
    "trailbase:version-policy:check": "node scripts/check-trailbase-version-policy.mjs",
    "trailbase:functional-ledgers:smoke": "bun scripts/smoke-trailbase-functional-ledgers.mjs",
    "trailbase:owned-currency:smoke": "bun scripts/smoke-trailbase-owned-currency.mjs",
    "trailbase:owned-currency:report": "bun packages/trailbase-runtime/bin/owned-currency-report.mjs",
    "apps-in-toss:snapshot": "node scripts/snapshot-apps-in-toss-docs.mjs",
    "apps-in-toss:snapshot:test": "node --test scripts/apps-in-toss-snapshot*.test.mjs scripts/apps-in-toss-tracking.test.mjs",
    "apps-in-toss:tracking:check": "node scripts/check-apps-in-toss-tracking.mjs",
    "consumer-sdk-compat:test": "node --test scripts/check-consumer-sdk-compatibility.test.mjs",
    "review-request:test": "node --test templates/clients/review-request/review-request-controller.test.mjs",
    "sampo:release-notes:draft": "node scripts/draft-sampo-release-notes.mjs",
    "skills:sync": "bun scripts/sync-agent-skills.mjs --target codex --all --mode link",
    "skills:sync:copy": "bun scripts/sync-agent-skills.mjs --target codex --all --mode copy",
    "skills:sync:cline": "bun scripts/sync-agent-skills.mjs --target cline --all --mode link",
    "skills:sync:claude": "bun scripts/sync-agent-skills.mjs --target claude-code --all --mode link",
    "skills:sync:agent": "bun scripts/sync-agent-skills.mjs",
    "skills:check": "bun scripts/check-agent-skills.mjs --target codex --all",
    "skills:check:agent": "bun scripts/check-agent-skills.mjs",
    "skills:validate": "bun scripts/validate-agent-skills.mjs",
    "packages:typecheck": "tsc --project tsconfig.json",
    "trailbase:wasm:smoke": "bun scripts/smoke-trailbase-wasm.mjs",
    "packages:typecheck:minimum": "node scripts/check-sdk-minimum.mjs && tsc --project tsconfig.sdk-min.json"
  },
  "devDependencies": {
    "@apps-in-toss/framework": "2.10.10",
    "@types/node": "24",
    "typescript": "7.0.2",
    "@apps-in-toss/framework-min-supported": "npm:@apps-in-toss/framework@2.10.10",
    "@apps-in-toss/web-framework": "3.4.0"
  }
}
