    "skills:sync:cline": "bun scripts/sync-agent-skills.mjs --target cline --all --mode link",
    "skills:sync:claude": "bun scripts/sync-agent-skills.mjs --target claude-code --all --mode link",
    "skills:sync:agent": "bun scripts/sync-agent-skills.mjs",
    "skills:validate": "bun scripts/validate-agent-skills.mjs"
  }
}
